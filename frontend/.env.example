# Leave empty in local Vite dev — /api is proxied to the Spring Boot server.
# VITE_API_BASE_URL=/api/v1

# Used for footer / Swagger links in the UI
VITE_BACKEND_ORIGIN=http://localhost:8080

# Neon Auth URL from the Neon Console (Auth settings)
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth

# Optional — derived from VITE_NEON_AUTH_URL if omitted (app data still uses Spring Boot)
# VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-9.us-east-2.aws.neon.tech/neondb/rest/v1

# To call the API without the Vite proxy (e.g. preview build):
# VITE_API_BASE_URL=http://localhost:8080/api/v1
