# Optional overrides (defaults are in application.yml for Neon)
# Render injects PORT; locally you can use either:
PORT=8080
SERVER_PORT=8080

# Allow Vite (local) + Vercel frontends to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,https://*.vercel.app,https://your-app.vercel.app

# Public URL shown in Swagger (Render)
# APP_PUBLIC_API_URL=https://monthlybudgetcalculator.onrender.com

# Neon Managed Auth JWT validation (EdDSA JWKS)
# NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth..../neondb/auth/.well-known/jwks.json
# NEON_AUTH_ISSUER=https://ep-xxx.neonauth....aws.neon.tech

# Neon JDBC (set these on Render — do not commit real secrets)
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/neondb?sslmode=require&prepareThreshold=0
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=
